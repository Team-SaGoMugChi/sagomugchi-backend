APP_ENV=local
ALLOWED_ORIGINS=["*"]

# Firestore 쓰기(baseline 저장)용 서비스 계정 키 경로.
# Firebase 콘솔(oddo-emotion-diary) > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 → 다운로드한
# JSON을 server/ 안에 두고 아래에 경로 지정 (README.md "Firestore 쓰기 설정" 참고)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# 상담 대화·리포트용 LLM (OpenAI)
# LLM_API_KEY=
LLM_MODEL=gpt-4o
# NAVER_CLOVA_API_KEY=

# 실제 상담에는 false 유지. 예시 감정·상담 주제로 UI 흐름만 확인할 때 true.
COUNSEL_DUMMY_CONTEXT=false

# 위기 판정 2단계(LLM). true면 규칙이 놓친 발화를 gpt-4o-mini가 한 번 더 본다.
COUNSEL_LLM_JUDGE=false
COUNSEL_JUDGE_MODEL=gpt-4o
COUNSEL_JUDGE_TIMEOUT_SEC=5

# KOTE local inference; first request downloads ~500 MB.
KOTE_CACHE_DIR=.cache/kote
KOTE_LOCAL_FILES_ONLY=false
KOTE_DEVICE=cpu
KOTE_THRESHOLD=0.4

# Naver CLOVA Speech (STT). NCP 콘솔 > Services > CLOVA Speech > Domain 목록에서
# 해당 도메인의 Invoke URL과 Secret Key 두 값을 복사해 넣는다.
# Secret Key는 앱(APK)에 넣지 않는다 — AI 서버만 CLOVA를 호출한다.
# CLOVA_SPEECH_INVOKE_URL=
# CLOVA_SPEECH_SECRET=

# 영상 생성(Step3, app/videomake). 인증은 API 키가 아니라 ADC:
#   gcloud auth application-default login
# 기본은 더미(true, 회색 영상, 과금 0). 실제 생성은 false로 바꿀 때만 돈다(작업당 약 $5).
VIDEOMAKE_DUMMY=true
# 시나리오(스토리보드)를 짜는 LLM: openai(팀 표준) | gemini
# 키는 용도별로 나눈다: 영상은 VIDEOMAKE_OPENAI_API_KEY, 상담은 위의 LLM_API_KEY.
# 모델도 따로다 — 상담용 LLM_MODEL은 gpt-4o(GPT-5 계열은 상담 코드의 max_tokens·temperature와 맞지 않는다).
# 연습 모드(VIDEOMAKE_DUMMY=true)에서는 영상 키가 없어도 된다.
VIDEOMAKE_LLM_PROVIDER=openai
# VIDEOMAKE_OPENAI_API_KEY=
VIDEOMAKE_OPENAI_MODEL=gpt-5.5
# 실제 생성(VIDEOMAKE_DUMMY=false)할 때만 채운다. 이미지·영상·나레이션은 Vertex.
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=global
# VIDEOMAKE_IMAGE_MODEL=gemini-3.1-flash-image
# VIDEOMAKE_VIDEO_MODEL=veo-3.1-fast-generate-001
# VIDEOMAKE_TTS_MODEL=gemini-3.1-flash-tts-preview
# VIDEOMAKE_TTS_VOICE=Autonoe
# 나레이션 목소리: fish(기본, Fish Audio 쇼츠 목소리) / gemini. Fish 키가 없으면 자동으로 Gemini로 읽는다.
# 키는 https://fish.audio/app/api-keys 에서 무료로 만든다(s2.1-pro-free 모델은 0원).
FISH_API_KEY=
# VIDEOMAKE_NARRATION_TTS=fish
# VIDEOMAKE_FISH_MODEL=s2.1-pro-free
# 목소리 바꾸기: Fish 사이트 목소리 페이지 주소의 ID. 연예인 복제 목소리는 쓰지 않는다.
# VIDEOMAKE_FISH_VOICE_ID=4e118bfbb83e401c84699c09b5f08257
# 편집: 목소리가 끝난 뒤 정적을 잘라 컷을 줄인다(무음 컷·편집감독이 고른 동작 컷은 그대로).
# VIDEOMAKE_TIGHT_EDIT=true
# VIDEOMAKE_EDIT_TAIL_SECONDS=1.1
# 배경음악: 편집감독(LLM)이 분위기상 필요하다고 본 구간에만 작게(Lyria 2, 곡당 $0.06). 끄려면 false.
# VIDEOMAKE_MUSIC=true
# VIDEOMAKE_MUSIC_LEVEL_DB=-34
# 작업 하나의 예상 비용이 이 값을 넘으면 렌더하지 않는다 (USD).
VIDEOMAKE_MAX_COST_USD=6.00
# 제작팀 시나리오 모드(작가→감독→검수→촬영감독). 기본 single.
# VIDEOMAKE_PLANNER=team
# 영상 모델을 evolink.ai(Grok 등)로 바꿀 때만. 기본은 Veo.
# VIDEOMAKE_VIDEO_PROVIDER=evolink
# VIDEOMAKE_EVOLINK_API_KEY=
# VIDEOMAKE_EVOLINK_QUALITY=480p