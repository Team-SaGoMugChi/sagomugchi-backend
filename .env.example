APP_ENV=local
ALLOWED_ORIGINS=["*"]

# Firestore 쓰기(baseline 저장)용 서비스 계정 키 경로.
# Firebase 콘솔(oddo-emotion-diary) > 프로젝트 설정 > 서비스 계정 > 새 비공개 키 생성 → 다운로드한
# JSON을 server/ 안에 두고 아래에 경로 지정 (README.md "Firestore 쓰기 설정" 참고)
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Phase 5+ (아직 팀 결정 전 — ROADMAP.md 참고), 준비되면 값 채우기
# LLM_API_KEY=
# NAVER_CLOVA_API_KEY=

# 실제 상담에는 false 유지. 예시 감정·상담 주제로 UI 흐름만 확인할 때 true.
COUNSEL_DUMMY_CONTEXT=false

# KOTE local inference; first request downloads ~500 MB.
KOTE_CACHE_DIR=.cache/kote
KOTE_LOCAL_FILES_ONLY=false
KOTE_DEVICE=cpu
KOTE_THRESHOLD=0.4

# Naver CLOVA Speech (STT). NCP 콘솔 > Services > CLOVA Speech > Domain 목록에서
# 해당 도메인의 Invoke URL과 Secret Key 두 값을 복사해 넣는다.
# Secret Key는 앱(APK)에 넣지 않는다 — AI 서버만 CLOVA를 호출한다.
# CLOVA_SPEECH_INVOKE_URL=
# CLOVA_SPEECH_SECRET=

# 영상 생성(Step3, app/videomake). 인증은 API 키가 아니라 ADC:
#   gcloud auth application-default login
# GCP 없이 흐름만 확인하려면 VIDEOMAKE_DUMMY=true (ffmpeg는 필요).
# GOOGLE_CLOUD_PROJECT=
VIDEOMAKE_DUMMY=true
# 시나리오(스토리보드)를 짜는 LLM: gemini | openai
# openai면 위의 팀 공용 LLM_API_KEY를 쓴다. 이미지·영상·나레이션은 어느 쪽이든 Vertex.
VIDEOMAKE_LLM_PROVIDER=gemini
# VIDEOMAKE_OPENAI_MODEL=gpt-4o-mini
# 작업 하나의 예상 비용이 이 값을 넘으면 렌더하지 않는다 (USD).
VIDEOMAKE_MAX_COST_USD=6.00
